{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/phac-nml/typingQC/main/assets/schema_input.json",
    "title": "phac-nml/typingQC pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "meta": ["irida_id"],
                "unique": true,
                "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "sample_name": {
                "type": "string",
                "meta": ["id"],
                "errorMessage": "Same name is optional, if provided will replace sample for filenames and outputs"
            },
            "mikrokondo_data": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.flat_sample\\.json(\\.gz)?$",
                "errorMessage": "JSON file containing data generated by mikrokondo, cannot contain spaces and must have the extensions: '.json' or '.json.gz'."
            },
            "predicted_identification_name": {
                "type": "string",
                "meta": ["Species"],
                "errorMessage": "Species called by mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "qc_status_overall": {
                "type": "string",
                "meta": ["QCStatus"],
                "errorMessage": "Sequencing QC Status - mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "predicted_primary_type_name": {
                "type": "string",
                "meta": ["Serotype"],
                "errorMessage": "Predicted serotypes determined using typing tools (e.g. ECTyper, SISTR) from mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            }
        },
        "required": ["sample", "mikrokondo_data", "predicted_identification_name", "qc_status_overall"]
    }
}
