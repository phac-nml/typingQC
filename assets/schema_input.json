{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/phac-nml/typingQC/main/assets/schema_input.json",
    "title": "phac-nml/typingQC pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "meta": ["irida_id"],
                "unique": true,
                "errorMessage": "Sample name must be provided and cannot contain spaces"
            },
            "sample_name": {
                "type": "string",
                "meta": ["id"],
                "errorMessage": "Same name is optional, if provided will replace sample for filenames and outputs"
            },
            "sistr_data": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.sistr\\.subtyping\\.(tab|tsv)$",
                "errorMessage": "Automatically generated SISTR tabulated data from mikrokondo for Salmonella samples. File cannot contain spaces."
            },
            "ectyper_data": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.output\\.ectyper\\.subtyping\\.(tab|tsv)$",
                "errorMessage": "Automatically generated ECTyper tabulated data from mikrokondo for Escherichia samples. File cannot contain spaces."
            },
            "predicted_identification_name": {
                "type": "string",
                "meta": ["Species"],
                "errorMessage": "Species called by mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "QC_status_overall": {
                "type": "string",
                "meta": ["QCStatus"],
                "errorMessage": "Sequencing QC Status - mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "N50_value": {
                "type": "string",
                "meta": ["N50"],
                "errorMessage": "N50 value - mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "raw_average_quality_value": {
                "type": "string",
                "meta": ["AvgQuality"],
                "errorMessage": "Sequencing Average Quality - mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "length_value": {
                "type": "string",
                "meta": ["Length"],
                "errorMessage": "Genome length - mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "nr_contigs_value": {
                "type": "string",
                "meta": ["NrContigs"],
                "errorMessage": "Number of contigs in genome - Mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "ectyper_qcflag": {
                "type": "string",
                "meta": ["ECTYPERqc"],
                "errorMessage": "ECTyper QC Status - Mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            },
            "sistr_qc_status": {
                "type": "string",
                "meta": ["SISTRqc"],
                "errorMessage": "SISTR QC Status - Mikrokondo.",
                "default": "",
                "pattern": "^[^\\n\\t\"]+$"
            }
        },
        "required": ["sample", "predicted_identification_name", "QC_status_overall"]
    }
}
