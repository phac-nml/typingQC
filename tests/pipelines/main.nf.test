nextflow_pipeline {

    name "Integration test of TypingQC pipeline"
    script "main.nf"

    test("Test of full pipeline"){
        tag "pipeline_success"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet1.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.success
            assert path("$launchDir/results").exists()

            // Will expand on this as the modules are developed
            assert path("$launchDir/results/ectyper_qc_results.txt").exists()
            assert path("$launchDir/results/sistr_qc_results.txt").exists()
            assert path("$launchDir/results/sequence_qc_results.txt").exists()
            assert path("$launchDir/results/fail_typing_results.txt").exists()
        }
    }
}
