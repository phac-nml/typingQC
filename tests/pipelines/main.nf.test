nextflow_pipeline {

    name "Integration test of TypingQC pipeline"
    script "main.nf"

    test("Test of full pipeline"){
        tag "pipeline_success"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet1.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.success
            assert path("$launchDir/results").exists()

            assert path("$launchDir/results/merge/TypingQC_inputs.csv").exists()
            assert path("$launchDir/results/ectyperqc/EC001_ectyperQC.csv").exists()
            assert path("$launchDir/results/ectyperqc/EC002_ectyperQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM001_sistrQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM003_sistrQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM004_sistrQC.csv").exists()
            assert path("$launchDir/results/sequenceqc/SALM003_sequenceQC.csv").exists()
            assert path("$launchDir/results/exclusions/LIST001_exclusions.csv").exists()
            assert path("$launchDir/results/exclusions/LIST001_SAMPLE7_exclusions.csv").exists()
            assert path("$launchDir/results/serotype/TypingQC_report.csv").exists()

            // check TypingQC_report csv file

            def outputFile = path("$launchDir/results/serotype/TypingQC_report.csv")
            assert outputFile.exists()

            // Read CSV into rows
            def csv = outputFile.readLines()
            def header = csv[0].split(",")
            def values = csv[1].split(",", 7)

            assert header == ["sample", "sample_name", "typingQC_message", "quality_metrics", "Validated_Toxins", "Validated_STXSubtypes", "Validated_Serotype"]
            assert values[0] == "SAMPLE1"
            assert values[1] == "EC001"
            assert values[2].contains("[ECTYPER_PASS]")
            assert values[3].isEmpty()

            // check IRIDA Next JSON output
            def iridanext_json = path("$launchDir/results/iridanext.output.json").json
            def iridanext_global = iridanext_json.files.global
            def iridanext_metadata = iridanext_json.metadata.samples

            // global output file
            assert iridanext_global.findAll {it.path == "serotype/TypingQC_report.csv" }.size() == 1

            // output metadata
            assert iridanext_metadata.SAMPLE3."typingQC_message" == "[TYPE_FAIL] Serovar 'IV Y:g,z51:-' is NOT REPORTABLE. Perform TRADITIONAL SEROTYPING."
            assert iridanext_metadata.SAMPLE7."typingQC_message" == "[FAIL] TypingQC unsupported for species: Listeria monocytogenes"
            assert iridanext_metadata.SAMPLE1."typingQC_message" == "[ECTYPER_PASS]"
            assert iridanext_metadata.SAMPLE4."typingQC_message" == "[SISTR_PASS]"
            assert iridanext_metadata.SAMPLE2."typingQC_message" == "[ECTYPER_PASS]"
        }
    }

    test("Testing samples that fail sequencing"){
        tag "pipeline_success_sequenceQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_sequence.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.success
            assert path("$launchDir/results").exists()
            assert path("$launchDir/results/serotype/TypingQC_report.csv").exists()
            assert path("$launchDir/results/merge/TypingQC_inputs.csv").exists()
            assert path("$launchDir/results/ectyperqc/EC004_ectyperQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM001_sistrQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM002_sistrQC.csv").exists()

            def outputFile = path("$launchDir/results/sequenceqc/SALM002_sequenceQC.csv")
            assert outputFile.exists()

            // Read CSV into rows
            def csv = outputFile.readLines()
            def header = csv[0].split(",")
            def values = csv[1].split(",", 4)

            assert header == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values[0] == "SAMPLE2"
            assert values[1] == "SALM002"
            assert values[2].contains("[SEQ_FAIL] Sample may be contaminated.")
            assert values[3].contains("[FAILED n50_value] 87033")
            assert values[3].contains("[FAILED nr_contigs] 257")
            assert values[3].contains("[FAILED length] 6443773")
            assert values[3].contains("[FAILED checkm2_contamination] 6.35")

            def outputFile2 = path("$launchDir/results/sequenceqc/EC004_sequenceQC.csv")
            assert outputFile2.exists()

            // Read CSV into rows
            def csv2 = outputFile2.readLines()
            def header2 = csv2[0].split(",")
            def values2 = csv2[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header2 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values2[0] == "SAMPLE7"
            assert values2[1] == "EC004"
            assert values2[2].contains("[SEQ_FAIL] Resequencing is recommended. QUALITY_METRICS did not meet PNC requirements.")
            assert values2[3].contains("[FAILED average_coverage] 33.48")

            def outputFile3 = path("$launchDir/results/sequenceqc/CAMP001_sequenceQC.csv")
            assert outputFile3.exists()

            // Read CSV into rows
            def csv3 = outputFile3.readLines()
            def header3 = csv3[0].split(",")
            def values3 = csv3[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header3 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values3[0] == "SAMPLE6"
            assert values3[1] == "CAMP001"
            assert values3[2].contains("[SEQ_FAIL] Resequencing is recommended. QUALITY_METRICS did not meet PNC requirements.")
            assert values3[2].contains("[FAIL] Typing unsupported for Campylobacter coli")
            assert values3[3].contains("[FAILED average_coverage] 26.99")
            assert values3[3].contains("[FAILED n50_value] 28835")
        }
    }

    test("Testing samples that cannot be typed with current genotyping tools"){
        tag "pipeline_success_exclusions"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_exclusions.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.success
            assert path("$launchDir/results").exists()
            assert path("$launchDir/results/serotype/TypingQC_report.csv").exists()
            assert path("$launchDir/results/merge/TypingQC_inputs.csv").exists()
            assert path("$launchDir/results/sequenceqc/CAMP001_sequenceQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM001_sistrQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM004_sistrQC.csv").exists()

            def outputFile_list = path("$launchDir/results/exclusions/LIST001_exclusions.csv")
            assert outputFile_list.exists()

            // Read CSV into rows
            def csv_list = outputFile_list.readLines()
            def header_list = csv_list[0].split(",")
            def values_list = csv_list[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_list == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_list[0] == "SAMPLE4"
            assert values_list[1] == "LIST001"
            assert values_list[2].contains("[FAIL] TypingQC unsupported for species: Listeria monocytogenes")
            assert values_list[3].contains("Overall sequence QC status: PASS")
        }
    }

    test("Testing samples with SISTR typing data"){
        tag "pipeline_success_sistrQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_sistr.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.success
            assert path("$launchDir/results").exists()
            assert path("$launchDir/results/serotype/TypingQC_report.csv").exists()
            assert path("$launchDir/results/merge/TypingQC_inputs.csv").exists()
            assert path("$launchDir/results/sequenceqc/SALM002_sequenceQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM012_sistrQC.csv").exists()
            assert path("$launchDir/results/sistrqc/SALM014_sistrQC.csv").exists()

            def outputFile_salm = path("$launchDir/results/sistrqc/SALM001_sistrQC.csv")
            assert outputFile_salm.exists()

            // Read CSV into rows
            def csv_salm = outputFile_salm.readLines()
            def header_salm = csv_salm[0].split(",")
            def values_salm = csv_salm[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_salm == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm[0] == "SAMPLE1"
            assert values_salm[1] == "SALM001"
            assert values_salm[2].contains("[TYPE_FAIL]")

            def outputFile_salm2 = path("$launchDir/results/sistrqc/SALM005_sistrQC.csv")
            assert outputFile_salm2.exists()

            // Read CSV into rows
            def csv_salm2 = outputFile_salm2.readLines()
            def header_salm2 = csv_salm2[0].split(",")
            def values_salm2 = csv_salm2[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_salm2 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm2[0] == "SAMPLE3"
            assert values_salm2[1] == "SALM005"
            assert values_salm2[2].contains("[SISTR_PASS]")
            assert values_salm2[3].contains("Only matched 294 cgMLST330 loci. Min threshold for confident serovar prediction from cgMLST is 297.0")

            def outputFile_salm3 = path("$launchDir/results/sistrqc/SALM008_sistrQC.csv")
            assert outputFile_salm3.exists()

            // Read CSV into rows
            def csv_salm3 = outputFile_salm3.readLines()
            def header_salm3 = csv_salm3[0].split(",")
            def values_salm3 = csv_salm3[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_salm3 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm3[0] == "SAMPLE4"
            assert values_salm3[1] == "SALM008"
            assert values_salm3[2].contains("[TYPE_FAIL] Serovar 'IIIb Y:z52:z' is NOT REPORTABLE. Perform TRADITIONAL SEROTYPING.")
            assert values_salm3[3].isEmpty()

            def outputFile_salm4 = path("$launchDir/results/sistrqc/SALM009_sistrQC.csv")
            assert outputFile_salm4.exists()

            // Read CSV into rows
            def csv_salm4 = outputFile_salm4.readLines()
            def header_salm4 = csv_salm4[0].split(",")
            def values_salm4 = csv_salm4[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_salm4 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm4[0] == "SAMPLE5"
            assert values_salm4[1] == "SALM009"
            assert values_salm4[2].contains("[SISTR_PASS]")
            assert values_salm4[3].isEmpty()

            def outputFile_salm5 = path("$launchDir/results/sistrqc/SALM010_sistrQC.csv")
            assert outputFile_salm5.exists()

            // Read CSV into rows
            def csv_salm5 = outputFile_salm5.readLines()
            def header_salm5 = csv_salm5[0].split(",")
            def values_salm5 = csv_salm5[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_salm5 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm5[0] == "SAMPLE6"
            assert values_salm5[1] == "SALM010"
            assert values_salm5[2].contains("[SISTR_FAIL] Serotyping unsuccessful.")
            assert values_salm5[2].contains("RESEQUENCING or TRADITIONAL SEROTYPING is advised.")
            assert values_salm5[3].contains("WARNING: H1 antigen gene (fliC) missing. Cannot determine H1 antigen. Cannot accurately predict serovar from antigen genes")

            def outputFile_salm6 = path("$launchDir/results/sistrqc/SALM007_sistrQC.csv")
            assert outputFile_salm6.exists()

            // Read CSV into rows
            def csv_salm6 = outputFile_salm6.readLines()
            def header_salm6 = csv_salm6[0].split(",")
            def values_salm6 = csv_salm6[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_salm6 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm6[0] == "SAMPLE7"
            assert values_salm6[1] == "SALM007"
            assert values_salm6[2].contains("[FAIL] Re-run mikrokondo to generate SISTR data.")
            assert values_salm6[3].contains("Sample predicted to be Salmonella_enterica but no SISTR data found")

            def outputFile_salm7 = path("$launchDir/results/sistrqc/SALM011_sistrQC.csv")
            assert outputFile_salm7.exists()

            // Read CSV into rows
            def csv_salm7 = outputFile_salm7.readLines()
            def header_salm7 = csv_salm7[0].split(",")
            def values_salm7 = csv_salm7[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_salm7 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm7[0] == "SAMPLE8"
            assert values_salm7[1] == "SALM011"
            assert values_salm7[2].contains("[TYPE_FAIL] Serovar 'Adelaide|Agodi' is NOT REPORTABLE. Perform TRADITIONAL SEROTYPING.")
            assert values_salm7[3].contains("WARNING: Only matched 215 cgMLST330 loci. Min threshold for confident serovar prediction from cgMLST is 297.0")

            def outputFile_salm8 = path("$launchDir/results/sistrqc/SALM002_sistrQC.csv")
            assert outputFile_salm8.exists()

            // Read CSV into rows
            def csv_salm8 = outputFile_salm8.readLines()
            def header_salm8 = csv_salm8[0].split(",")
            def values_salm8 = csv_salm8[1].split(",", 4) // Only split first 3 commas (4 columns)

            assert header_salm8 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm8[0] == "SAMPLE2"
            assert values_salm8[1] == "SALM002"
            assert values_salm8[2].contains("[TYPE_FAIL]")
            assert values_salm8[3].contains("WARNING: Input genome size (6443773 bp) not within expected range of 4000000-6000000 (bp) for Salmonella")

            def outputFile_salm9 = path("$launchDir/results/sistrqc/SALM013_sistrQC.csv")
            assert outputFile_salm9.exists()

            // Read CSV into rows
            def csv_salm9 = outputFile_salm9.readLines()
            def header_salm9 = csv_salm9[0].split(",")
            def values_salm9 = csv_salm9[1].split(",",4) // Only split first 3 commas (4 columns)

            assert header_salm9 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm9[0] == "SAMPLE10"
            assert values_salm9[1] == "SALM013"
            assert values_salm9[2].contains("[SISTR_PASS]")

            def outputFile_salm10 = path("$launchDir/results/sistrqc/SALM014_sistrQC.csv")
            assert outputFile_salm10.exists()

            // Read CSV into rows
            def csv_salm10 = outputFile_salm10.readLines()
            def header_salm10 = csv_salm10[0].split(",")
            def values_salm10 = csv_salm10[1].split(",",4) // Only split first 3 commas (4 columns)

            assert header_salm10 == ["sample", "sample_name", "typingQC_message", "quality_metrics"]
            assert values_salm10[0] == "SAMPLE11"
            assert values_salm10[1] == "SALM014"
            assert values_salm10[2].contains("[SISTR_PASS]")
            assert values_salm10[3].contains("WARNING: Wzx/Wzy genes missing. Cannot determine O-antigen serogroup.")

            // check TypingQC_report csv file to ensure serovar updates are successful for sistrQC

            def outputFileQC = path("$launchDir/results/serotype/TypingQC_report.csv")
            assert outputFileQC.exists()

            // Read CSV into rows
            def csvQC = outputFileQC.readLines()
            def headerQC = csvQC[0].split(",")
            def valuesQC = csvQC[2].split(",", 7)
            def valuesQC2 = csvQC[3].split(",", 7)

            assert headerQC == ["sample", "sample_name", "typingQC_message", "quality_metrics", "Validated_Toxins", "Validated_STXSubtypes", "Validated_Serotype"]
            assert valuesQC[0] == "SAMPLE10"
            assert valuesQC[1] == "SALM013"
            assert valuesQC[2].contains("[SISTR_PASS]")
            assert valuesQC[3].isEmpty()
            assert valuesQC[6].contains("Panama/Houston")
            assert valuesQC2[0] == "SAMPLE11"
            assert valuesQC2[1] == "SALM014"
            assert valuesQC2[2].contains("[SISTR_PASS]")
            assert valuesQC2[3].contains("WARNING: Wzx/Wzy genes missing. Cannot determine O-antigen serogroup.; WARNING: Predicted serovar Sendai has been reported as Miami to conform with current CDC serovar nomenclature.")
            assert valuesQC2[4].isEmpty()
            assert valuesQC2[6].contains("Miami")
            }
    }

    test("SISTR module without reportable serovar input"){
        tag "pipeline_failure_sistrQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_sistr.csv"
                reportable_serovars = ""
                outdir = "results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it =~ /Argument of .* function cannot be empty/ }
        }
    }

    test("Missing reportable_serovars file triggers error in SISTR"){
        tag "pipeline_failure_sistrQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_sistr.csv"
                reportable_serovars = "./reportables.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.contains("* --reportable_serovars: the file or directory './reportables.csv' does not exist.")
        }
    }

    test("Empty reportable_serovars file triggers error in SISTR"){
        tag "pipeline_failure_sistrQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_sistr.csv"
                reportable_serovars = "$baseDir/tests/data/serovars/reportables.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.contains("  ValueError: No valid serovars found in reportables.csv.")
        }
    }

    test("Incorrect JSON file used for sample"){
        tag "pipeline_failure_JSON"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_incorrectJSON.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.contains("  ValueError: Sample ID mismatch: JSON contains 'SALM001' but expected 'SALM002'.")
        }
    }

    test("Testing samples with ECTYPER typing data"){
        tag "pipeline_success_ectyperQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_ectyper.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.success
            assert path("$launchDir/results").exists()
            assert path("$launchDir/results/serotype/TypingQC_report.csv").exists()
            assert path("$launchDir/results/merge/TypingQC_inputs.csv").exists()
            assert path("$launchDir/results/sequenceqc/EC004_sequenceQC.csv").exists()

            def outputFile_ec1 = path("$launchDir/results/ectyperqc/EC001_ectyperQC.csv")
            assert outputFile_ec1.exists()

            def content = outputFile_ec1.text
            assert content.contains("EC001")
            assert content.contains("[ECTYPER_PASS]")
            assert content.contains("eae,ehxA,stx2")
            assert content.contains("n/a")

            def outputFile_ec2 = path("$launchDir/results/ectyperqc/EC002_ectyperQC.csv")
            assert outputFile_ec2.exists()

            // Read CSV into rows
            def csv_ec2 = outputFile_ec2.readLines()
            def header_ec2 = csv_ec2[0].split(",")
            def values_ec2 = csv_ec2[1].split(",", 6) // Only split first 5 commas (6 columns)

            assert header_ec2 == ["sample", "sample_name", "typingQC_message", "quality_metrics", "Validated_Toxins", "Validated_STXSubtypes"]
            assert values_ec2[0] == "SAMPLE2"
            assert values_ec2[1] == "EC002"
            assert values_ec2[2].contains("[ECTYPER_PASS]")
            assert values_ec2[3].isEmpty()
            assert values_ec2[4].contains("eae")
            assert values_ec2[5].contains("n/a")

            def outputFile_ec3 = path("$launchDir/results/ectyperqc/EC004_ectyperQC.csv")
            assert outputFile_ec3.exists()

            def content2 = outputFile_ec3.text
            assert content2.contains("SAMPLE3")
            assert content2.contains("EC004")
            assert content2.contains("[ECTYPER_PASS]")
            assert content2.contains("eae,ehxA,stx1")
            assert content2.contains("n/a")

            def outputFile_ec4 = path("$launchDir/results/ectyperqc/EC005_ectyperQC.csv")
            assert outputFile_ec4.exists()

            def content3 = outputFile_ec4.text
            assert content3.contains("SAMPLE4")
            assert content3.contains("EC005")
            assert content3.contains("[ECTYPER_WARNING] Mixed O type detected.")
            assert content3.contains("Mixed O-type: O20/O137:H41")
            assert content3.contains("ehxA,stx1,stx2")
            assert content3.contains("n/a")

            def outputFile_ec5 = path("$launchDir/results/ectyperqc/EC006_ectyperQC.csv")
            assert outputFile_ec5.exists()

            def content4 = outputFile_ec5.text
            assert content4.contains("EC006")
            assert content4.contains("Failed to type O antigen")
            assert content4.contains("[ECTYPER_FAIL] RESEQUENCING or TRADITIONAL SEROTYPING is advised.")
            assert content4.contains("ehxA,stx1,stx2")
            assert content4.contains("n/a")

            def outputFile_ec6 = path("$launchDir/results/ectyperqc/EC007_ectyperQC.csv")
            assert outputFile_ec6.exists()

            def content5 = outputFile_ec6.text
            assert content5.contains("EC007")
            assert content5.contains("H-antigen has %identity or %coverage below reportable threshold")
            assert content5.contains("[ECTYPER_FAIL] THRESHOLD adjustment, RESEQUENCING or TRADITIONAL SEROTYPING is advised.")
            assert content5.contains("eae,ehxA,stx1")
            assert content5.contains("n/a")

            def outputFile_ec7 = path("$launchDir/results/ectyperqc/EA001_ectyperQC.csv")
            assert outputFile_ec7.exists()

            def content6 = outputFile_ec7.text
            assert content6.contains("EA001")
            assert content6.contains("[ECTYPER_WARNING] Sample identified as Escherichia albertii.")
            assert content6.contains("Species identified as non-E.coli. Serotyping skipped; toxin typing completed.")
            assert content6.contains("eae,stx2")
            assert content6.contains("stx2f")
        }
    }
    test("Missing validated toxin file triggers error in ECTYPER"){
        tag "pipeline_failure_ectyperQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_ectyper.csv"
                validated_toxins = "./toxins.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stderr.contains("* --validated_toxins: the file or directory './toxins.csv' does not exist.")
        }
    }

    test("Empty toxin file triggers error in ECTYPER"){
        tag "pipeline_failure_ectyperQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_ectyper.csv"
                validated_toxins = "$baseDir/tests/data/serovars/no_toxins.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.contains("  ValueError: No valid genes found in no_toxins.csv.")
        }
    }

    test("Incorrect toxin file format triggers error in ECTYPER"){
        tag "pipeline_failure_ectyperQC"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/samplesheet_ectyper.csv"
                validated_toxins = "$baseDir/tests/data/serovars/toxins.csv"
                outdir = "results"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.contains("  ValueError: Line(s) in toxins.csv contain(s) multiple items. Each gene should be on a separate line.")
        }
    }
}
