iridanext {
    enabled = true
    output {
        path = "${params.outdir}/iridanext.output.json.gz"
        overwrite = true
        files {
            idkey = "irida_id"
            global = [
                "**/csvtk/RDS_report.csv"
            ]
        }
        metadata {
            samples {
                ignore = ["quality_metrics"]
                csv {
                    path = "**/csvtk/RDS_report.csv"
                    idcol = "sample"
                }
            }
        }
    }
}
